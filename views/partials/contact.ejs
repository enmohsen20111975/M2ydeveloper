<!-- Contact Section -->
<section class="contact" id="contact">
    <div class="container">
        <div class="section-header">
            <span class="section-badge" data-i18n="contact_title">Get in Touch</span>
            <h2 class="section-title" data-i18n="contact_subtitle">We'd Love to Hear From You</h2>
            <p class="section-description" data-i18n="contact_description">
                Have questions or need assistance? Our team is here to help. Reach out to us anytime!
            </p>
        </div>
        
        <div class="contact-grid">
            <div class="contact-info">
                <div class="contact-card">
                    <div class="contact-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <h3 data-i18n="contact_card1_title">Email Us</h3>
                    <p data-i18n="contact_card1_text">info@m2y.net</p>
                    <a href="mailto:info@m2y.net" class="link-with-icon">
                        <span data-i18n="contact_send_message_link">Send Message</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                
                <div class="contact-card">
                    <div class="contact-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <h3 data-i18n="contact_card2_title">Call Us</h3>
                    <p data-i18n="contact_card2_text">+20 128 764 4099</p>
                    <p>+2 887 991 6040</p>
                    <a href="tel:+201287644099" class="link-with-icon">
                        <span data-i18n="contact_call_now">Call Now</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                
                <div class="contact-card">
                    <div class="contact-icon">
                        <i class="fas fa-code"></i>
                    </div>
                    <h3 data-i18n="contact_card3_title">Development</h3>
                    <p data-i18n="contact_card3_text">M2ydevelopers</p>
                    <a href="#" class="link-with-icon">
                        <span data-i18n="contact_learn_more">Learn More</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <div class="contact-form-wrapper">
                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label for="name" data-i18n="contact_form_name">Your Name</label>
                        <input type="text" id="name" name="name" required data-i18n="contact_form_name" placeholder="Your Name">
                    </div>
                    
                    <div class="form-group">
                        <label for="email" data-i18n="contact_form_email">Your Email</label>
                        <input type="email" id="email" name="email" required data-i18n="contact_form_email" placeholder="Your Email">
                    </div>
                    
                    <div class="form-group">
                        <label for="platform" data-i18n="contact_form_subject">Subject</label>
                        <select id="platform" name="platform" required>
                            <option value="" data-i18n="contact_platform_select">Select a platform</option>
                            <option value="engisuite">EngiSuite</option>
                            <option value="invist">Invist</option>
                            <option value="both" data-i18n="contact_platform_both">Both Platforms</option>
                            <option value="general" data-i18n="contact_platform_general">General Inquiry</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="message" data-i18n="contact_form_message">Your Message</label>
                        <textarea id="message" name="message" rows="5" required data-i18n="contact_form_message" placeholder="Your Message"></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-large btn-primary">
                        <span data-i18n="contact_form_submit">Send Message</span>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
                <div id="formMessage" class="form-message"></div>
            </div>
        </div>
    </div>
</section>
