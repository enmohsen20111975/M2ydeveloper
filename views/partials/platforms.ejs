<!-- Platforms Section -->
<section class="platforms" id="platforms">
    <div class="container">
        <div class="section-header">
            <span class="section-badge" data-i18n="platforms_title">Our Platforms</span>
            <h2 class="section-title" data-i18n="platforms_subtitle">Powerful Tools at Your Fingertips</h2>
            <p class="section-description" data-i18n="platforms_description">
                Explore our integrated platforms designed to streamline your workflow and maximize your potential.
            </p>
        </div>
        
        <div class="platforms-grid">
            <!-- EngiSuite Platform -->
            <div class="platform-card">
                <div class="platform-image">
                    <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800&auto=format&fit=crop&q=80" 
                         alt="EngiSuite - Engineering Excellence Platform" 
                         loading="lazy">
                    <div class="platform-overlay">
                        <div class="platform-badge" data-i18n="platform_engisuite_badge">Engineering</div>
                    </div>
                </div>
                
                <div class="platform-content">
                    <div class="platform-header">
                        <div class="platform-icon engisuite">
                            <i class="fas fa-cogs"></i>
                        </div>
                        <div>
                            <h3 class="platform-title" data-i18n="platform_engisuite_title">EngiSuite</h3>
                            <p class="platform-subtitle" data-i18n="platform_engisuite_subtitle">Engineering Excellence Platform</p>
                        </div>
                    </div>
                    
                    <p class="platform-description" data-i18n="platform_engisuite_description">
                        Comprehensive engineering project management suite with powerful collaboration tools, task tracking, and resource management.
                    </p>
                    
                    <ul class="platform-features">
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_engisuite_feature1">Advanced Project Management</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_engisuite_feature2">Real-time Collaboration Tools</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_engisuite_feature3">Resource Allocation & Tracking</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_engisuite_feature4">Comprehensive Reporting</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_engisuite_feature5">Integration with CAD Software</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_engisuite_feature6">Quality Assurance Workflows</span></li>
                    </ul>
                    
                    <div class="platform-cta">
                        <a href="<%= engisuite_url %>" class="btn btn-large btn-primary" target="_blank" rel="noopener">
                            <span data-i18n="platform_engisuite_cta">Explore EngiSuite</span>
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                        <a href="#contact" class="link-with-icon">
                            <span data-i18n="platform_request_demo">Request Demo</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Invist Platform -->
            <div class="platform-card">
                <div class="platform-image">
                    <img src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=800&auto=format&fit=crop&q=80" 
                         alt="Invist - Smart Investment Management Platform" 
                         loading="lazy">
                    <div class="platform-overlay">
                        <div class="platform-badge" data-i18n="platform_invist_badge">Investment</div>
                    </div>
                </div>
                
                <div class="platform-content">
                    <div class="platform-header">
                        <div class="platform-icon invist">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div>
                            <h3 class="platform-title" data-i18n="platform_invist_title">Invist</h3>
                            <p class="platform-subtitle" data-i18n="platform_invist_subtitle">Smart Investment Management</p>
                        </div>
                    </div>
                    
                    <p class="platform-description" data-i18n="platform_invist_description">
                        Smart investment platform with real-time market data, portfolio management, and intelligent trading tools.
                    </p>
                    
                    <ul class="platform-features">
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_invist_feature1">Portfolio Management Dashboard</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_invist_feature2">Real-time Market Analytics</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_invist_feature3">Risk Assessment Tools</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_invist_feature4">Automated Investment Strategies</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_invist_feature5">Performance Tracking & Reports</span></li>
                        <li><i class="fas fa-check-circle"></i> <span data-i18n="platform_invist_feature6">Secure Transaction Processing</span></li>
                    </ul>
                    
                    <div class="platform-cta">
                        <a href="<%= invist_url %>" class="btn btn-large btn-primary" target="_blank" rel="noopener">
                            <span data-i18n="platform_invist_cta">Explore Invist</span>
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                        <a href="#contact" class="link-with-icon">
                            <span data-i18n="platform_request_demo">Request Demo</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
