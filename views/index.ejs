<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    
    <!-- Primary Meta Tags -->
    <title><%= title %></title>
    <meta name="title" content="<%= title %>">
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="engineering solutions, investment platform, EngiSuite, Invist, business automation, project management, portfolio management">
    <meta name="robots" content="index, follow">
    <meta name="language" content="English">
    <meta name="author" content="M2Y.net">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://m2y.net/">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="https://m2y.net/assets/og-image.jpg">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://m2y.net/">
    <meta property="twitter:title" content="<%= title %>">
    <meta property="twitter:description" content="<%= description %>">
    <meta property="twitter:image" content="https://m2y.net/assets/twitter-image.jpg">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://m2y.net/">
    
    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Stylesheet -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/platform-integration.css">
    <link rel="stylesheet" href="/css/theme.css">

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7305205048390136"
        crossorigin="anonymous"></script>
    
    <!-- Structured Data / Schema.org -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "M2Y.net",
      "url": "https://m2y.net",
      "logo": "https://m2y.net/assets/logo.png",
      "description": "Engineering and Investment Solutions Platform",
      "sameAs": [
        "<%= engisuite_url %>",
        "<%= invist_url %>"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Customer Service",
        "email": "info@m2y.net"
      }
    }
    </script>
</head>
<body>
    <%- include('partials/navbar') %>
    <%- include('partials/hero') %>
    <%- include('partials/about') %>
    <%- include('partials/platforms', { engisuite_url, invist_url }) %>
    <%- include('partials/features') %>
    <%- include('partials/cta', { engisuite_url, invist_url }) %>
    <%- include('partials/contact') %>
    <%- include('partials/footer', { year }) %>
    
    <!-- Back to Top Button -->
    <button class="back-to-top" id="backToTop" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- JavaScript -->
    <script src="/js/translations.js"></script>
    <script src="/js/switcher.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/platform-data.js"></script>
</body>
</html>
